{
  "tools": [
    {
      "name": "get_latest_sku_snapshot",
      "description": "Get the latest snapshot for a store and product.",
      "inputSchema": {
        "type": "object",
        "required": ["store_id", "product_id"],
        "properties": {
          "store_id": {"type": "string", "description": "Store identifier, for example S001."},
          "product_id": {"type": "string", "description": "Product identifier, for example P0001."}
        }
      }
    },
    {
      "name": "get_sku_history",
      "description": "Get SKU snapshots in an inclusive date range.",
      "inputSchema": {
        "type": "object",
        "required": ["store_id", "product_id", "start_date", "end_date"],
        "properties": {
          "store_id": {"type": "string"},
          "product_id": {"type": "string"},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"}
        }
      }
    },
    {
      "name": "list_region_day_snapshots",
      "description": "List snapshots for a region and date.",
      "inputSchema": {
        "type": "object",
        "required": ["region", "snapshot_date"],
        "properties": {
          "region": {"type": "string", "description": "Region name, for example East."},
          "snapshot_date": {"type": "string", "format": "date"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 5}
        }
      }
    },
    {
      "name": "simulate_reorder_recommendation",
      "description": "Create a draft reorder simulation that always requires human approval.",
      "inputSchema": {
        "type": "object",
        "required": ["store_id", "product_id", "cover_days", "lead_time_days"],
        "properties": {
          "store_id": {"type": "string"},
          "product_id": {"type": "string"},
          "cover_days": {"type": "integer", "minimum": 1},
          "lead_time_days": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
